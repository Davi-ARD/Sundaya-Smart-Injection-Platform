// Schema Prisma untuk SSIP (Sundaya Smart Injection Platform).
// Enum di sini harus konsisten dengan packages/shared/src/index.ts.
// Single-provider: penyedia selalu Sundaya (user sistem, di-seed sebagai owner mesin).
// Dual layer: OperationalData (Layer 1, Teknisi) dan LogProduksi (Layer 2, Admin Penyewa)
// keduanya append-only. Lihat docs/ssip-spec.md dan PROJECT_CONTEXT.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN_SUNDAYA
  TEKNISI_SUNDAYA
  MANAGER_PENYEWA
  ADMIN_PENYEWA
}

// Sumbu ketersediaan/rental mesin (siklus booking).
// Mesin tidak pernah keluar dari Sundaya (penyewa yang mengirim cetakan ke sini),
// jadi tidak ada status pengiriman atau pengembalian mesin. Tidak ada status
// "diajukan" terpisah untuk mesin: keputusan Admin sekaligus mengunci mesin dalam
// satu aksi assign, jadi TERSEDIA langsung ke DIKONFIRMASI.
enum MachineStatus {
  TERSEDIA
  DIKONFIRMASI
  AKTIF
  PENGECEKAN
  MAINTENANCE
}

// Sumbu operasional realtime mesin (Layer 1). Teknisi hanya menginput SETUP dan
// RUNNING. STANDBY hanya status awal saat mesin pertama didaftarkan Admin Sundaya.
// MAINTENANCE disetel otomatis oleh modul Maintenance, bukan diinput Teknisi.
enum MachineOperationalStatus {
  STANDBY
  SETUP
  RUNNING
  MAINTENANCE
}

enum WarrantyStatus {
  AKTIF
  HABIS
}

// Lifecycle booking/job (dulu RentalStatus).
// DIKONFIRMASI disetel saat Admin Sundaya meminjamkan mesin pertama. AKTIF dan
// SELESAI otomatis dari event domain: AKTIF saat cetakan pertama diterima Sundaya
// (Log Penerimaan), SELESAI saat seluruh cetakan booking sudah COMPLETED.
enum JobLifecycle {
  DIAJUKAN
  DITOLAK
  DIKONFIRMASI
  AKTIF
  SELESAI
}

// Status job untuk dashboard Sundaya (dihitung dari sisa sewa dan progress).
enum JobStatus {
  ON_SCHEDULE
  WARNING
  CRITICAL
  COMPLETED
}

enum ExtensionStatus {
  DIAJUKAN
  DITERIMA
  DITOLAK
}

// Tracking fisik mold (6-state linear). Transisi otomatis dari event domain:
// PLANNING (mold didaftarkan Manager) -> DELIVERY (Manager buat Log Pengiriman
// mold) -> RECEIVED (Admin Sundaya buat Log Penerimaan mold) -> PRODUCTION
// (Admin Penyewa catat produksi harian pertama) -> SEND_BACK (manual) ->
// COMPLETED (manual). Hanya dua transisi terakhir yang ditekan tombol.
enum MoldTrackingStatus {
  PLANNING
  DELIVERY
  RECEIVED
  PRODUCTION
  COMPLETED
}

// Jenis barang pada Log Pengiriman (Manager) dan Log Penerimaan (Admin Sundaya).
// Kondisi barang saat diterima. CUKUP_BAIK dan TIDAK_BAIK wajib disertai catatan
// (ditegakkan di service, bukan di database).
enum KondisiBarang {
  BAIK
  CUKUP_BAIK
  TIDAK_BAIK
}

enum ItemPengiriman {
  MOLD
  MATERIAL
}

// Progress molding (Layer 2, Log Produksi).
enum ProgressMolding {
  PLANNING
  ONGOING
  SUDAH_DIPRODUKSI
}

// Jenis event Log Produksi (Layer 2 timeline).
// Kedatangan material tidak ada di sini: sudah dicatat Manager di Log Pengiriman
// dan dikonfirmasi Admin Sundaya di Log Penerimaan.
enum LogProduksiEventType {
  PRODUKSI_HARIAN
  PROGRESS_MOLDING
}

enum MaintenanceType {
  PREVENTIVE
  CORRECTIVE
}

enum MaintenanceStatus {
  TERJADWAL
  BERLANGSUNG
  SELESAI
}

model User {
  id           String   @id @default(cuid())
  nama         String
  email        String   @unique
  passwordHash String
  role         Role
  // ADMIN_PENYEWA (child) menunjuk MANAGER_PENYEWA (parent). Role lain null.
  parentId     String?
  // Identitas perusahaan untuk MANAGER_PENYEWA (tenant root). ponytail: tenant =
  // subtree parentId, belum perlu model Customer terpisah.
  companyName  String?
  isActive     Boolean  @default(true)
  avatarUrl    String?
  createdAt    DateTime @default(now())

  parent   User?  @relation("PenyewaHierarchy", fields: [parentId], references: [id])
  children User[] @relation("PenyewaHierarchy")

  machines           Machine[]
  jobsAsManager      Job[]               @relation("JobManager")
  jobsAssigned       Job[]               @relation("JobAssignedBy")
  molds              Mold[]
  moldTrackingEvents MoldTrackingEvent[]
  logProduksi        LogProduksi[]
  logPengiriman      LogPengiriman[]     @relation("LogPengirimanBy")
  logPenerimaan      LogPenerimaan[]     @relation("LogPenerimaanBy")
  operationalData    OperationalData[]
  maintenances       Maintenance[]
  notifications      Notification[]
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, isRead])
}

model Machine {
  id                     String                   @id @default(cuid())
  // Digenerate service dengan pola IM-001 berurutan, bukan diinput manual.
  machineNumber          String                   @unique
  spesifikasi            String
  // Clamping force mesin. Mesin hanya boleh menjalankan mold dengan tonase <= ini.
  tonaseTon              Int
  status                 MachineStatus            @default(TERSEDIA) // sumbu ketersediaan/rental
  operationalStatus      MachineOperationalStatus @default(STANDBY)  // sumbu realtime Layer 1
  // Status operasional sebelum maintenance dimulai, dipakai untuk memulihkan
  // mesin ke posisi semula saat maintenance selesai. Null di luar maintenance.
  statusBeforeMaintenance MachineOperationalStatus?
  // Owner selalu user sistem Sundaya (single-provider). FK dipertahankan agar
  // relasi tetap eksplisit; penegakan single-provider ada di service.
  ownerId                String
  warrantyStart          DateTime
  warrantyEnd            DateTime
  warrantyStatus         WarrantyStatus
  // Arsip (soft-delete): mesin tetap ada demi relasi job/operational, cuma
  // disembunyikan dari daftar aktif.
  isArchived             Boolean                  @default(false)
  createdAt              DateTime                 @default(now())

  owner           User              @relation(fields: [ownerId], references: [id])
  // Relasi banyak-ke-banyak: satu booking dipinjami beberapa mesin, dan satu mesin
  // dipakai beberapa booking sepanjang waktu (riwayat tetap terbaca setelah sewa
  // selesai). Ketersediaan tetap dijaga kolom status, bukan oleh relasi ini.
  jobs            Job[]
  logProduksi     LogProduksi[]
  operationalData OperationalData[]
  maintenances    Maintenance[]
}

// Cetakan milik Manager Penyewa. Satu booking (Job) bisa memuat beberapa cetakan,
// tapi satu cetakan hanya ikut satu booking: jobId null berarti belum dibooking.
// Plan material dan target output tinggal di sini (diisi saat merancang cetakan),
// jadi form booking tidak menanyakannya lagi. Keduanya menjadi batas keras di
// Log Produksi: output tidak boleh melewati targetOutput, material terpakai tidak
// boleh melewati estimasiKg.
model Mold {
  id                String             @id @default(cuid())
  kodeMold          String             @unique
  namaProduk        String
  cavity            Int
  tonaseTon         Int
  deskripsi         String?
  managerId         String
  jobId             String?
  trackingStatus    MoldTrackingStatus?
  planMaterialUtama String?
  estimasiKg        Float?
  targetOutput      Float?
  createdAt         DateTime           @default(now())

  manager        User                @relation(fields: [managerId], references: [id])
  job            Job?                @relation(fields: [jobId], references: [id])
  trackingEvents MoldTrackingEvent[]
  logProduksi    LogProduksi[]
  logPengiriman  LogPengiriman[]
  logPenerimaan  LogPenerimaan[]
  runs           MoldProductionRun[]

  @@index([jobId])
}

// Satu sesi produksi cetakan. Cetakan yang sudah selesai boleh dipakai lagi
// selama masa sewa berjalan: Manager menetapkan target output baru (boleh lebih
// besar maupun lebih kecil dari sesi sebelumnya) lalu mengirim material lagi.
//
// Barisnya append-only sehingga sekaligus menjadi riwayat: target lama tetap
// terbaca setelah diganti target baru, lengkap dengan hasil sesi itu.
//
// goodAwal dan materialAwal adalah akumulasi cetakan SEBELUM sesi ini dimulai.
// Dengan begitu capaian satu sesi dihitung sebagai selisih terhadap akumulasi
// berjalan, tanpa perlu menyalin angka produksi ke sini.
model MoldProductionRun {
  id           String   @id @default(cuid())
  moldId       String
  jobId        String?
  targetOutput Float
  estimasiKg   Float?
  goodAwal     Float    @default(0)
  materialAwal Float    @default(0)
  byId         String
  at           DateTime @default(now())

  mold Mold @relation(fields: [moldId], references: [id], onDelete: Cascade)

  @@index([moldId, at])
}

// Histori pergerakan mold (append-only). Timestamp RECEIVED dipakai sebagai
// aktual-tiba mold di view Log Pengiriman.
model MoldTrackingEvent {
  id     String             @id @default(cuid())
  moldId String
  status MoldTrackingStatus
  at     DateTime           @default(now())
  byId   String

  mold Mold @relation(fields: [moldId], references: [id])
  by   User @relation(fields: [byId], references: [id])

  @@index([moldId])
}

// Production Job (evolve dari Rental). Satu booking memuat satu atau lebih cetakan
// (relasi Mold.jobId) dan satu mesin untuk seluruh booking: cetakan di dalamnya
// dikerjakan bergantian di mesin itu. Mesin di-assign Admin Sundaya, null saat booking.
//
// Plan material, target output, dan tonase tidak diduplikasi di sini melainkan
// dibaca dari tiap Mold. Lokasi tujuan dibuang: single-provider, tujuannya selalu
// lokasi Sundaya.
model Job {
  id                    String       @id @default(cuid())
  // Nomor job unik per perusahaan penyewa, bukan global: tiap tenant punya
  // antrean sekuensnya sendiri supaya jumlah booking tenant lain tidak terbaca
  // dari nomor job sendiri.
  jobNumber             String
  managerId             String
  assignedById          String?
  lifecycle             JobLifecycle @default(DIAJUKAN)
  jobStatus             JobStatus    @default(ON_SCHEDULE)
  // Jumlah mesin yang diminta penyewa. Sundaya meminjamkan mesin sebanyak ini secara
  // bertahap; tidak ada pemasangan mesin ke cetakan tertentu.
  requestedMachineCount Int          @default(1)
  requestedDurationDays Int
  startDate             DateTime?
  endDate               DateTime?
  catatan               String?
  confirmedAt           DateTime?
  // Cetakan pertama tiba di Sundaya: booking jadi AKTIF dan masa sewa mulai
  // dihitung dari sini, bukan dari startDate rencana penyewa. Waktu penutupan
  // tidak disalin ke sini: sudah terekam di MoldTrackingEvent cetakan terakhir.
  receivedAt            DateTime?
  rejectionReason       String?
  createdAt             DateTime     @default(now())

  molds         Mold[]
  machines      Machine[]
  manager       User              @relation("JobManager", fields: [managerId], references: [id])
  assignedBy    User?             @relation("JobAssignedBy", fields: [assignedById], references: [id])
  extensions    RentalExtension[]
  logProduksi   LogProduksi[]
  logPengiriman LogPengiriman[]
  logPenerimaan LogPenerimaan[]

  @@unique([managerId, jobNumber])
}

// Log Pengiriman (milik Manager Penyewa). Log informasi kapan mold atau material
// akan dikirim ke Sundaya, bukan pembanding rencana vs aktual. Membuat log item
// MOLD memindahkan tracking mold ke DELIVERY. Admin Sundaya menerima notifikasi.
model LogPengiriman {
  id           String         @id @default(cuid())
  jobId        String
  // Wajib untuk item MOLD: booking bisa memuat beberapa cetakan, jadi log harus
  // menyebut cetakan mana yang dikirim. Null untuk item MATERIAL.
  moldId       String?
  item         ItemPengiriman
  rencanaKirim DateTime
  // Khusus item MATERIAL.
  materialName String?
  jumlahKg     Float?
  noSuratJalan String?
  catatan      String?
  byId         String
  createdAt    DateTime       @default(now())

  job  Job  @relation(fields: [jobId], references: [id])
  mold Mold? @relation(fields: [moldId], references: [id])
  by   User @relation("LogPengirimanBy", fields: [byId], references: [id])

  @@index([jobId, rencanaKirim])
}

// Log Penerimaan (milik Admin Sundaya). Konfirmasi mold atau material tiba di
// lokasi Sundaya. Membuat log item MOLD memindahkan tracking mold ke RECEIVED
// sekaligus menjalankan booking-nya (DIKONFIRMASI -> AKTIF, masa sewa mulai).
// Manager Penyewa menerima notifikasi.
model LogPenerimaan {
  id           String         @id @default(cuid())
  jobId        String
  // Wajib untuk item MOLD (lihat LogPengiriman). Null untuk item MATERIAL.
  moldId       String?
  item         ItemPengiriman
  diterimaAt   DateTime
  // Khusus item MATERIAL.
  materialName String?
  jumlahKg     Float?
  noSuratJalan String?
  kondisi      KondisiBarang?
  catatan      String?
  byId         String
  createdAt    DateTime       @default(now())

  job  Job  @relation(fields: [jobId], references: [id])
  mold Mold? @relation(fields: [moldId], references: [id])
  by   User @relation("LogPenerimaanBy", fields: [byId], references: [id])

  @@index([jobId, diterimaAt])
}

model RentalExtension {
  id             String          @id @default(cuid())
  jobId          String
  additionalDays Int
  status         ExtensionStatus @default(DIAJUKAN)
  requestedAt    DateTime        @default(now())
  decidedAt      DateTime?

  job Job @relation(fields: [jobId], references: [id])
}

// Log Produksi (Layer 2, append-only, diinput Admin Penyewa). Single-table
// timeline: kolom nullable per jenis event. Pengganti ProductionBatch.
model LogProduksi {
  id         String               @id @default(cuid())
  jobId      String
  // Cetakan yang dicatat. Batas output dan material ditetapkan per cetakan, jadi
  // tiap event harus menyebut cetakan mana supaya batasnya bisa ditegakkan.
  moldId     String
  // Mesin yang menjalankan cetakan itu pada event ini. Booking meminjamkan beberapa
  // mesin tanpa memasangkannya ke cetakan, jadi pasangan sebenarnya baru diketahui
  // dari log ini. Kedua jenis event terjadi di atas mesin, jadi selalu terisi.
  machineId  String
  eventType  LogProduksiEventType
  occurredAt DateTime
  byId       String
  catatan    String?
  // PRODUKSI_HARIAN. materialUsedKg = material yang dipakai hari itu; sisa dihitung
  // sistem sebagai Mold.estimasiKg minus akumulasi terpakai.
  goodProduct    Int?
  rejectCount    Int?
  materialUsedKg Float?
  // PROGRESS_MOLDING
  progressMolding    ProgressMolding?
  keteranganProgress String?
  createdAt          DateTime         @default(now())

  job     Job     @relation(fields: [jobId], references: [id])
  mold    Mold    @relation(fields: [moldId], references: [id])
  machine Machine @relation(fields: [machineId], references: [id])
  by      User    @relation(fields: [byId], references: [id])

  @@index([jobId, occurredAt])
  @@index([moldId, eventType])
  @@index([machineId])
}

// Operational Data (Layer 1, append-only, diinput Teknisi Sundaya). Sumbu waktu
// untuk Availability dan Utilization; cycleTimeSec jadi masukan Performance.
// Reason code six big losses tidak lagi diinput manual: setup dan maintenance
// terbaca dari status, performance dari cycle time, quality dari Layer 2.
model OperationalData {
  id           String                   @id @default(cuid())
  machineId    String
  status       MachineOperationalStatus
  // Durasi satu siklus molding penuh (tutup, injeksi, pendinginan, eject).
  // Kanonik dalam detik; UI menerima dan menampilkan jam + menit + detik.
  cycleTimeSec Float?
  occurredAt   DateTime
  byId         String
  catatan      String?
  createdAt    DateTime                 @default(now())

  machine Machine @relation(fields: [machineId], references: [id])
  by      User    @relation(fields: [byId], references: [id])

  @@index([machineId, occurredAt])
}

model Maintenance {
  id          String            @id @default(cuid())
  machineId   String
  type        MaintenanceType
  status      MaintenanceStatus @default(TERJADWAL)
  scheduledAt DateTime
  // Diisi saat transisi status. Durasi startedAt sampai completedAt pada
  // maintenance CORRECTIVE menjadi sumber MTBF dan MTTR di dashboard.
  startedAt   DateTime?
  completedAt DateTime?
  notes       String?
  byId        String
  createdAt   DateTime          @default(now())

  machine Machine @relation(fields: [machineId], references: [id])
  by      User    @relation(fields: [byId], references: [id])
}
